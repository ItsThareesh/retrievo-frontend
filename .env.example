APP_ENV=development # Change this to production for enabling domain restrictions for signup

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXTAUTH_SECRET= # Added by `npx auth`

# Required by Auth.js
AUTH_TRUST_HOST=true

# OPTIONAL: pin Auth.js's base URL for OAuth callbacks. Unset by default —
# Auth.js derives it from the request's Host header. Only needed when host
# detection is unreliable, e.g. behind a dev reverse proxy/tunnel where Next
# dev reports its origin as localhost:3000 and Google sign-in fails with
# redirect_uri_mismatch.
AUTH_URL=

# Browser-facing backend URL (used by clientFetch's client-side default).
# Inlined into the client bundle, so it must resolve from the DEVICE running
# the browser — `backend:8000` (docker hostname) can NEVER go here:
#   laptop-only dev:  http://localhost:8000/api/v1
#   phone on LAN:     http://<laptop-ip>:8000/api/v1  (+ matching CORS origin on the backend)
#   phone + laptop, any network: https://dev-api.retrievo.dev/api/v1 (needs the Cloudflare Tunnel profile up)
# Prod (Vercel): your public backend URL. Also the fallback used by server-side
# code (NextAuth callbacks) when INTERNAL_BACKEND_URL is unset.
NEXT_PUBLIC_BACKEND_URL="http://localhost:8000/api/v1"

# Server-side only (NextAuth server callbacks). Uses the docker-internal
# hostname — not reachable from any browser. Set in docker-compose dev;
# not needed in production on Vercel, where the public NEXT_PUBLIC_BACKEND_URL
# above is the only way in.
INTERNAL_BACKEND_URL="http://backend:8000/api/v1"
